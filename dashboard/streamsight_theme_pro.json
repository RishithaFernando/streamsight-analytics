{
  "name": "StreamSight Pro",
  "dataColors": ["#1F5FBF", "#0E9AA7", "#0F2A4A", "#6FB1E8", "#E8A23A", "#7A8CA3", "#D64550", "#2F9E6E"],
  "background": "#FFFFFF",
  "foreground": "#0F2A4A",
  "foregroundNeutralSecondary": "#5B6B7F",
  "foregroundNeutralTertiary": "#8A99AD",
  "backgroundLight": "#EAF2FC",
  "backgroundNeutral": "#E3E8EF",
  "tableAccent": "#1F5FBF",
  "good": "#2F9E6E",
  "neutral": "#E8A23A",
  "bad": "#D64550",
  "maximum": "#123C7C",
  "center": "#7FB2E5",
  "minimum": "#EAF2FC",
  "null": "#C5CEDA",
  "textClasses": {
    "callout": {"fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#0F2A4A"},
    "title":   {"fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0F2A4A"},
    "header":  {"fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#0F2A4A"},
    "label":   {"fontSize": 10, "fontFace": "Segoe UI", "color": "#5B6B7F"}
  },
  "visualStyles": {
    "page": {"*": {
      "background": [{"color": {"solid": {"color": "#F4F6F9"}}, "transparency": 0}],
      "outspace":   [{"color": {"solid": {"color": "#F4F6F9"}}}]
    }},
    "*": {"*": {
      "title": [{"show": true, "fontColor": {"solid": {"color": "#0F2A4A"}}, "fontSize": 12,
                 "fontFamily": "Segoe UI Semibold", "alignment": "left"}],
      "background": [{"show": true, "color": {"solid": {"color": "#FFFFFF"}}, "transparency": 0}],
      "border": [{"show": true, "color": {"solid": {"color": "#E3E8EF"}}, "radius": 8}],
      "categoryAxis": [{"labelColor": {"solid": {"color": "#5B6B7F"}}, "fontSize": 10,
                        "showAxisTitle": false, "gridlineShow": false}],
      "valueAxis": [{"labelColor": {"solid": {"color": "#5B6B7F"}}, "fontSize": 10,
                     "showAxisTitle": false, "gridlineShow": true,
                     "gridlineColor": {"solid": {"color": "#E9EDF3"}}}],
      "legend": [{"show": true, "labelColor": {"solid": {"color": "#5B6B7F"}}, "fontSize": 10}]
    }},
    "card": {"*": {
      "labels": [{"color": {"solid": {"color": "#0F2A4A"}}, "fontSize": 28, "fontFamily": "Segoe UI Semibold"}],
      "categoryLabels": [{"show": true, "color": {"solid": {"color": "#5B6B7F"}}, "fontSize": 11}]
    }},
    "lineChart": {"*": {
      "lineStyles": [{"strokeWidth": 2.5, "showMarker": false}]
    }},
    "tableEx": {"*": {
      "columnHeaders": [{"fontColor": {"solid": {"color": "#FFFFFF"}}, "backColor": {"solid": {"color": "#0F2A4A"}},
                         "fontSize": 10, "fontFamily": "Segoe UI Semibold"}],
      "values": [{"fontColor": {"solid": {"color": "#1F2D3D"}}, "backColor": {"solid": {"color": "#FFFFFF"}},
                  "backColorSecondary": {"solid": {"color": "#F4F6F9"}}, "fontSize": 10}],
      "grid": [{"gridHorizontal": true, "gridHorizontalColor": {"solid": {"color": "#E9EDF3"}}, "gridVertical": false}]
    }},
    "pivotTable": {"*": {
      "columnHeaders": [{"fontColor": {"solid": {"color": "#0F2A4A"}}, "fontSize": 10}],
      "rowHeaders": [{"fontColor": {"solid": {"color": "#0F2A4A"}}, "fontSize": 10}],
      "grid": [{"gridHorizontal": false, "gridVertical": false}]
    }},
    "slicer": {"*": {
      "items": [{"fontColor": {"solid": {"color": "#0F2A4A"}}, "textSize": 10}]
    }},
    "textbox": {"*": {
      "background": [{"show": false}], "border": [{"show": false}], "title": [{"show": false}]
    }},
    "shape": {"*": {
      "background": [{"show": false}], "border": [{"show": false}], "title": [{"show": false}]
    }}
  }
}
